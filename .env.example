# Copy this file to .env.local and add your own values.
# Keep secrets in .env.local; never commit them.

# API server
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Add at least one AI provider key to use the chat API.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
DEEPSEEK_API_KEY=
AGENT_PROVIDER_TIMEOUT_MS=45000
AGENT_PROVIDER_RETRIES=1

# Optional: Cloudflare R2 storage for repository sync.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional: database connection for database tooling.
DATABASE_URL=

# Optional: public URL used when generating repository links.
# EPICODESPACE_PUBLIC_URL=
# APP_PUBLIC_URL=

# Optional: customize the Git repository cache location.
# EPICODESPACE_GIT_CACHE_DIR=

# Frontend (Vite)
API_PORT=8080
# API_ORIGIN=http://localhost:8080
# API_SIDECAR_PORT=18080
# START_API_SIDECAR=0
# BASE_PATH=./
# VITE_APP_URL=

# Optional: these Vite variables are bundled into the public frontend.
# Do not put private secrets in VITE_* variables.
# VITE_WEBCONTAINER_APIKEY=
# VITE_ACCESS_PASSWORD_HASH=

# Optional: Replit development domain and CORS origin.
# REPLIT_DEV_DOMAIN=
# ALLOWED_ORIGIN=
